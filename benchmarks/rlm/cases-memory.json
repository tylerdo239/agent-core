{
  "suite": "memory-v1",
  "description": "Memory harness audit: multi-turn recall, compaction, and session summary",
  "cases": [
    {"id": "mem_simple_recall", "turns": [{"message": "Remember: my favorite color is crimson-99.", "checks": {"answer_any": ["crimson"], "max_iterations": 2}}, {"message": "What is my favorite color? Only the code.", "checks": {"answer_any": ["crimson"], "max_iterations": 3}}]},
    {"id": "mem_two_facts", "turns": [{"message": "Store these: project=amber-42, city=Hanoi.", "checks": {"answer_any": ["amber", "Hanoi"], "max_iterations": 2}}, {"message": "What city did I mention?", "checks": {"answer_any": ["Hanoi"], "max_iterations": 3}}, {"message": "And the project code?", "checks": {"answer_any": ["amber-42"], "max_iterations": 3}}]},
    {"id": "mem_overwrite", "turns": [{"message": "Remember code alpha-11.", "checks": {"answer_any": ["alpha"], "max_iterations": 2}}, {"message": "Actually change it to beta-22.", "checks": {"answer_any": ["beta"], "max_iterations": 2}}, {"message": "What is the current code?", "checks": {"answer_any": ["beta-22"], "max_iterations": 3}}]},
    {"id": "mem_no_leak", "turns": [{"message": "Store marker zebra-77.", "checks": {"answer_any": ["zebra"], "max_iterations": 2}}, {"message": "What is 3*3? Only the number.", "checks": {"answer_any": ["9"], "answer_not": ["zebra"], "max_iterations": 2}}]},
    {"id": "mem_long_context", "turns": [{"message": "I will give you a long list. Remember: the secret word is quasar-55 among many others: apple, banana, cherry, date, elderberry, fig, grape, honeydew, kiwi, lemon, mango, nectarine, orange, papaya, quince, raspberry, strawberry, tangerine, ugli, vanilla, watermelon, xigua, yuzu, zucchini.", "checks": {"answer_any": ["quasar"], "max_iterations": 2}}, {"message": "What was the secret word?", "checks": {"answer_any": ["quasar-55"], "max_iterations": 3}}]},
    {"id": "mem_sequential_build", "turns": [{"message": "We are building a list. Start with [1].", "checks": {"answer_any": ["1"], "max_iterations": 2}}, {"message": "Add 2 to the list.", "checks": {"answer_any": ["2"], "max_iterations": 3}}, {"message": "Add 3 and report the full list.", "checks": {"answer_any": ["1", "2", "3"], "max_iterations": 3}}]},
    {"id": "mem_ignore_distraction", "turns": [{"message": "Remember code delta-33 for later.", "checks": {"answer_any": ["delta"], "max_iterations": 2}}, {"message": "What is the capital of France?", "checks": {"answer_any": ["paris"], "max_iterations": 2}}, {"message": "Now what was the code I gave you earlier?", "checks": {"answer_any": ["delta-33"], "max_iterations": 3}}]},
    {"id": "mem_cross_turn_file_ref", "datasets": ["retail_sales.csv"], "turns": [{"message": "Using retail_sales.csv, what is the total revenue? Remember this number for next turn.", "checks": {"numeric_answers": [{"value": 163302.73, "tolerance": 1}], "max_iterations": 4}}, {"message": "What was the total revenue you just computed? Only the number.", "checks": {"numeric_answers": [{"value": 163302.73, "tolerance": 1}], "max_iterations": 3}}]},
    {"id": "mem_compaction_stress", "turns": [{"message": "Remember a=1, b=2, c=3, d=4, e=5. Confirm.", "checks": {"max_iterations": 2}}, {"message": "Remember f=6, g=7, h=8, i=9, j=10. Confirm.", "checks": {"max_iterations": 2}}, {"message": "What is a+j? Only the number.", "checks": {"numeric_answers": [{"value": 11, "tolerance": 0}], "max_iterations": 4}}]},
    {"id": "mem_stale_answer_check", "turns": [{"message": "Store marker omega-99.", "checks": {"answer_any": ["omega"], "max_iterations": 2}}, {"message": "Compute 5*5. Only the number.", "checks": {"numeric_answers": [{"value": 25, "tolerance": 0}], "answer_not": ["omega"], "max_iterations": 2}}]}
  ]
