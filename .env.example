# Copy sang .env rồi điền giá trị thật — .env KHÔNG được commit (đã có
# trong .gitignore/.dockerignore).

# Bắt buộc — thiếu 1 trong 4 là service exit(1) ngay lúc boot, không có
# default cứng nào trong code cho OPENAI_BASE_URL/OPENAI_MODEL_ID (identify
# 1 hạ tầng cụ thể — sai môi trường phải fail ngay, không âm thầm gọi nhầm
# proxy/model).
OPENAI_API_KEY=sk-...
OPENAI_BASE_URL=https://proxy.onebot.meobeo.ai/v1
OPENAI_MODEL_ID=hosted_vllm/Qwen/Qwen3.5-35B-A3B-FP8

# Module auth (nhiều người dùng thật) — API_KEYS dùng chung cũ đã bị THAY
# THẾ hoàn toàn bằng tài khoản Postgres (đăng ký/đăng nhập qua UI hoặc
# POST /auth/signup — user đầu tiên tự động thành admin). POSTGRES_PASSWORD
# bắt buộc, không có default — đổi trước khi deploy. DATABASE_URL đã được
# docker-compose tự lắp (trỏ vào service `postgres` cùng compose) — chỉ cần
# tự set DATABASE_URL nếu chạy `npm run serve` KHÔNG qua Docker (xem README
# mục "Chạy local" — cần `docker compose up postgres -d` trước để có DB).
POSTGRES_PASSWORD=doi-mat-khau-nay-truoc-khi-deploy

# Tuỳ chọn — phần còn lại của config llm-qwen, có default hợp lý trong code nếu bỏ trống.
# OPENAI_MAX_TOKENS=4096
# OPENAI_TIMEOUT_MS=60000
# OPENAI_ENABLE_THINKING=false
# OPENAI_EXTRA_BODY={"cache":{"no-cache":true},"chat_template_kwargs":{"enable_thinking":false},"timeout":240}

# Default loop context compaction. Nếu bỏ trống, dùng giá trị RLM tương ứng;
# nếu RLM cũng bỏ trống thì mặc định 30.000 tokens / compact ở 80%.
# DEFAULT_MODEL_CONTEXT_TOKENS=30000
# DEFAULT_COMPACTION_THRESHOLD_PCT=0.8

# Module memory (ctx.memory, TÙY CHỌN — xem
# docs/agent-core-memory-integration-plan.md). Bỏ trống cả 3 dòng dưới =
# ctx.memory KHÔNG mount, hệ thống chạy y hệt trước đây (memory là
# enhancement, không bắt buộc). Set MEMORY_CORE_URL thì BẮT BUỘC cũng set
# MEMORY_CORE_API_KEY (service exit(1) lúc boot nếu chỉ set 1 trong 2) — đây
# chính là user_key dùng để bootstrap tài khoản admin trong MemoryCore lúc
# boot (idempotent — service đã init trước đó vẫn boot bình thường).
# Docker Compose đã tự lắp MEMORY_CORE_URL trỏ vào service `memory-core`
# cùng compose — chỉ cần tự set nếu chạy `npm run serve` KHÔNG qua Docker.
# MEMORY_CORE_URL=http://localhost:8420
# MEMORY_CORE_API_KEY=doi-key-nay-truoc-khi-deploy
# MEMORY_CORE_SERVICE_ID=default

# Tuỳ chọn khác.
# STORAGE_PATH=data/sessions.db
# PORT_REST=8787
# WS đi chung port với REST từ Phase 6.3 (api-ws đã gộp vào api-rest) — không còn PORT_WS riêng.
# PORT_GRPC=50051
# PORT_WEB_UI=8790

# Deploy VPS domain riêng (app và API ở 2 subdomain KHÁC NHAU, vd.
# app-harness.onebot.meobeo.ai / api-harness.onebot.meobeo.ai) — xem
# docs/agent-core-vps-deploy-plan.md. Bỏ trống cả nhóm này = deployment
# 1-host mặc định (localhost hoặc 1 domain/IP duy nhất cho mọi thứ), không
# đổi hành vi gì cả.
#
# PORT_WEB_UI đổi thành port public của app (đã có sẵn ở trên, không phải
# biến mới) — vd. PORT_WEB_UI=4099 nếu web app expose ra ngoài ở port 4099.
#
# VITE_REST_URL/VITE_WS_URL: BUILD-TIME (Vite bake vào bundle lúc build, xem
# Dockerfile stage build-web) — đổi giá trị PHẢI `docker compose build
# agent-core` lại, restart KHÔNG đủ. Trỏ đúng domain/port public của API.
# VITE_REST_URL=https://api-harness.onebot.meobeo.ai:4098
# VITE_WS_URL=wss://api-harness.onebot.meobeo.ai:4098
#
# PORT_API_PUBLIC: port public DUY NHẤT gộp cả REST+WS (service api-gateway,
# xem docker-compose.yml + deploy/api-gateway.conf) — set thì service
# api-gateway mới cần chạy/hữu ích.
# PORT_API_PUBLIC=4098

# Phase 8 — production hardening round 2 (session/history/LLM-retry/storage
# retention). Tất cả đều tuỳ chọn, có default hợp lý trong code nếu bỏ trống.
# SESSION_TTL_MS=1800000           # 30 phút — session không hoạt động quá lâu bị sweep (TTL trượt, không phải tính từ lúc tạo)
# SESSION_SWEEP_INTERVAL_MS=60000  # 1 phút — chu kỳ kiểm tra session hết hạn
# OPENAI_MAX_RETRIES=2             # llm-qwen: số lần retry cho lỗi transient (network/429/5xx) — 3 lần gọi tối đa
# OPENAI_RETRY_BASE_DELAY_MS=300   # backoff nhân đôi mỗi lần: base * 2^attempt
# STORAGE_RETENTION_DAYS=          # KHÔNG set = không prune event nào (mặc định, backward compatible) — set số ngày nếu muốn tự dọn event cũ
# STORAGE_RETENTION_SWEEP_INTERVAL_MS=3600000  # 1 giờ — chỉ có tác dụng khi STORAGE_RETENTION_DAYS được set

# Audit fix (đối chiếu docs/agent-core-master-summary.md) — trước đây
# tool-web-search gọi DuckDuckGo không có timeout, có thể treo cả turn.
# WEB_SEARCH_TIMEOUT_MS=10000

# RLM backend — docker-compose mặc định chạy local provider bên trong container
# agent-core. Python source và scientific dependencies được build từ folder
# python/ của chính repo này; host không cần cài Python dependencies.
# RLM_SANDBOX_PROVIDER=local
# RLM_RUNTIME_ROOT=/app/python
# RLM_PYTHON_BIN=/usr/local/bin/python3
#
# Tuỳ chọn nâng cao: sandbox-docker tạo container/volume riêng cho từng session.
# Khi dùng chế độ này agent-core container phải truy cập được Docker daemon.
# RLM_SANDBOX_PROVIDER=docker
# RLM_DOCKER_IMAGE=agent-core:latest
# RLM_DOCKER_VOLUME_PREFIX=agent-core-rlm-workspace
# RLM_DOCKER_REMOVE_VOLUME_ON_CLOSE=true
# RLM_DOCKER_NETWORK_DISABLED=true
# RLM_DOCKER_MEMORY=8g
# RLM_DOCKER_CPUS=4
# RLM_DOCKER_PIDS_LIMIT=512
# Khi chạy local provider trực tiếp trên host (không qua compose):
# RLM_RUNTIME_ROOT=/absolute/path/to/agent-core/python
# RLM_WORKSPACE_BASE=/absolute/path/to/agent-core/data/rlm-workspaces
# RLM_PYTHON_BIN=/absolute/path/to/venv/bin/python
