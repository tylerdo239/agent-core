{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "agent-core/events/v1",
  "title": "Agent Core Event Envelope v1",
  "type": "object",
  "required": ["id", "seq", "sessionId", "timestamp", "type", "payload"],
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "seq": { "type": "integer", "minimum": 1 },
    "sessionId": { "type": "string", "minLength": 1 },
    "runId": { "type": "string", "minLength": 1 },
    "jobId": { "type": "string", "minLength": 1 },
    "timestamp": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}T" },
    "type": { "type": "string", "minLength": 1 },
    "payload": { "type": "object" },
    "versions": { "type": "object", "additionalProperties": { "type": "string" } }
  },
  "additionalProperties": false
}
